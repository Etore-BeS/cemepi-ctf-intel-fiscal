# Copy to .env and set local paths (never commit .env).
LAKE_ROOT=/path/to/lake/gilson
COLLECT_ROOT=/path/to/lake/gilson
DUMP_ROOT=/path/to/dumps/cemepi_api
CEMEPI_API_BASE=http://143.107.158.76:8010
CEMEPI_API_TOKEN=
EXTRACAO_ANO=2026
EXTRACAO_MES=3
SAMPLE_LIMIT=100

# Dados no HD (docs/ESTRUTURA.md, camada L0). Caminhos relativos são relativos à raiz do repo.
DATA_ROOT=/path/to/hd/CEMEPI

# pipelines/cnpj_enrich (uv run cnpj-pipeline ...). Workdir padrão: $DATA_ROOT/cnpj_enrich
CNPJ_PIPELINE_WORKDIR=/path/to/hd/CEMEPI/cnpj_enrich
CNPJ_TEMP_DIR=/path/to/hd/CEMEPI/cnpj_enrich/tmp
# Base CEMEPI (absoluta, ou relativa a DATA_ROOT). Padrão: $DATA_ROOT/api_ctf/cemepi.duckdb
CEMEPI_DUCKDB_MAIN=api_ctf/cemepi.duckdb
CNPJ_REF_RFB=2026-03
CNPJ_MEMORY_LIMIT=2GB
CNPJ_THREADS=2
# Só se a RFB mudar o compartilhamento do regime tributário:
# CNPJ_REGIME_SHARE=
# CNPJ_REGIME_BASE_URL=
# SEGREDO (HMAC do export anonimizar/--with-socios): preencha só no .env local; nunca commite, nunca cole em log.
# Gere com: uv run python -c 'import secrets; print(secrets.token_hex(32))'
CNPJ_HASH_SALT=
